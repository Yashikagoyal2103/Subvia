generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  refreshTokens    RefreshToken[]
  businessMembers  BusinessMember[]
  customerProfiles CustomerProfile[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum BusinessRole {
  BUSINESS_ADMIN
}

model Business {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          BusinessMember[]
  customerProfiles CustomerProfile[]
  services         Service[]
}

model BusinessMember {
  id         String       @id @default(uuid())
  userId     String
  businessId String
  role       BusinessRole
  createdAt  DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model CustomerProfile {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  subscriptions Subscription[]
  invoices Invoice[]
  creditLedger CreditLedger[]
}

model Service {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plans    Plan[]

  @@index([businessId])
}

model Plan {
  id          String          @id @default(uuid())
  serviceId   String
  name        String
  description String?
  price       Int
  currency    Currency
  interval    BillingInterval
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  service Service @relation(fields: [serviceId], references: [id])

  subscriptions        Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingPlan")

  @@index([serviceId])
}

enum Currency {
  INR
  USD
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum CreditEntryType {
  CREDIT
  DEBIT
}


model Subscription {
  id                String             @id @default(uuid())
  customerProfileId String
  planId            String
  pendingPlanId     String?
  status            SubscriptionStatus @default(PENDING)
  currency          Currency
  price             Int
  billingInterval   BillingInterval
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  cancelAtPeriodEnd Boolean            @default(false)
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  plan            Plan            @relation(fields: [planId], references: [id])
  pendingPlan     Plan?           @relation("PendingPlan", fields: [pendingPlanId], references: [id])

  invoices Invoice[]

  @@index([customerProfileId])
  @@index([planId])
  @@index([pendingPlanId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

model Invoice {
  id                String        @id @default(uuid())
  invoiceNumber     String        @unique
  customerProfileId String
  subscriptionId    String
  status            InvoiceStatus @default(DRAFT)
  currency          Currency
  subtotal          Int
  total             Int
  issuedAt          DateTime      @default(now())
  dueAt             DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  subscription    Subscription    @relation(fields: [subscriptionId], references: [id])
  items           InvoiceItem[]
  payments Payment[]
  creditLedger CreditLedger[]

  @@index([customerProfileId])
  @@index([subscriptionId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Int
  amount      Int
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String
  amount          Int
  currency        Currency
  status          PaymentStatus @default(PENDING)
  paymentMethod   String
  transactionId   String?       @unique
  failureReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
}

model CreditLedger {
  id                String          @id @default(uuid())
  customerProfileId String
  invoiceId         String?
  amount            Int
  currency          Currency
  type              CreditEntryType
  description       String
  createdAt         DateTime        @default(now())

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id])

  @@index([customerProfileId])
  @@index([invoiceId])
}